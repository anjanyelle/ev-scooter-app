#!/usr/bin/env sh
set -eu

GRADLE_VERSION=9.3.1
GRADLE_SHA256=b266d5ff6b90eada6dc3b20cb090e3731302e553a27c5d3e4df1f0d76beaff06
CACHE_DIR="${GRADLE_USER_HOME:-$HOME/.gradle}/wrapper/manual/gradle-${GRADLE_VERSION}"
GRADLE_BIN="$CACHE_DIR/gradle-${GRADLE_VERSION}/bin/gradle"

verify_zip() {
  if command -v sha256sum >/dev/null 2>&1; then
    printf '%s  %s\n' "$GRADLE_SHA256" "$1" | sha256sum -c - >/dev/null
  elif command -v shasum >/dev/null 2>&1; then
    printf '%s  %s\n' "$GRADLE_SHA256" "$1" | shasum -a 256 -c - >/dev/null
  elif command -v openssl >/dev/null 2>&1; then
    actual=$(openssl dgst -sha256 "$1" | awk '{print $NF}')
    [ "$actual" = "$GRADLE_SHA256" ]
  else
    echo "Install sha256sum, shasum, or openssl to verify the Gradle distribution." >&2
    return 1
  fi
}

if [ ! -x "$GRADLE_BIN" ]; then
  mkdir -p "$CACHE_DIR"
  ZIP_FILE="$CACHE_DIR/gradle-${GRADLE_VERSION}-bin.zip"
  URL="https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"
  rm -f "$ZIP_FILE"
  if command -v curl >/dev/null 2>&1; then
    curl -fL --retry 3 "$URL" -o "$ZIP_FILE"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$ZIP_FILE" "$URL"
  else
    echo "Install curl or wget so the Gradle distribution can be downloaded." >&2
    exit 1
  fi
  if ! verify_zip "$ZIP_FILE"; then
    echo "Gradle distribution checksum verification failed." >&2
    rm -f "$ZIP_FILE"
    exit 1
  fi
  if command -v unzip >/dev/null 2>&1; then
    unzip -q -o "$ZIP_FILE" -d "$CACHE_DIR"
  else
    echo "Install unzip so the Gradle distribution can be extracted." >&2
    exit 1
  fi
fi

exec "$GRADLE_BIN" "$@"

{
  "name": "lexicon-ev-companion",
  "version": "1.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "configure": "node scripts/generate-runtime-config.mjs",
    "prestart": "npm run configure",
    "start": "react-native start",
    "preandroid": "npm run configure",
    "android": "react-native run-android",
    "android:device": "react-native run-android --device",
    "android:release": "react-native run-android --mode=release",
    "android:apk": "npm run configure && cd android && ./gradlew assembleRelease",
    "android:aab": "npm run configure && cd android && ./gradlew bundleRelease",
    "lint": "eslint . --ext .js,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "audit:project": "node scripts/project-audit.mjs",
    "validate": "npm run configure && npm run audit:project && npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "7.18.14",
    "@react-navigation/native": "7.3.14",
    "@react-navigation/native-stack": "7.18.6",
    "lucide-react-native": "1.26.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "2.32.0",
    "react-native-keychain": "10.0.0",
    "react-native-maps": "1.29.0",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "4.22.0",
    "react-native-svg": "15.15.5",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "^0.11.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@types/react": "^19.2.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.19.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.2"
}
